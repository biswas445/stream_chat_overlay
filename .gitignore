# dependencies
node_modules/

# build output (vite) + packager artifacts (keep installers out of git)
dist/
release/
*.exe
*.msi
*.AppImage
*.dmg
*.zip

# local config / secrets — NEVER commit. The settings db (botrix-config.json)
# holds the private widget bid; it lives in %AppData% but this is the safety
# net for any local copy. Keys and certs are never tracked either.
.env
.env.*
botrix-config.json
overlay-state.json
*.pem
*.key
*.p12
*.pfx
.npmrc

# logs & OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
