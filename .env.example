# The BotRix multistream chat widget URL — the exact page an OBS browser
# source loads. Create a BotRix multistream widget at https://botrix.live,
# copy its URL (it carries the session id via ?bid=...), and paste it here.
#
# This file is read by the Electron main process to embed the widget in the
# chat panel iframe and to poll per-platform viewer counts.
BOTRIX_WIDGET_URL="https://botrix.live/...."
